{
	"name": "@misskey-dev/oxlint-fmt-config",
	"version": "0.2.0",
	"description": "oxlint/oxfmt config for misskey-dev",
	"license": "MIT",
	"packageManager": "pnpm@11.18.0",
	"files": [
		"built"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./built/index.mjs",
			"types": "./built/index.d.mts"
		},
		"./oxlint": {
			"import": "./built/oxlint/index.mjs",
			"types": "./built/oxlint/index.d.mts"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/misskey-dev/oxlint-fmt-config-misskey-dev"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsrs --fast --noEmit",
		"lint": "pnpm build && oxlint"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "6.0.1",
		"oxlint": "1.94.0",
		"tsdown": "0.23.7",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@stylistic/eslint-plugin": "^6",
		"oxlint": "^1",
		"oxlint-tsgolint": "^7",
		"tsrs": "0.25.0-ts7.1.0-beta"
	},
	"peerDependenciesMeta": {
		"oxlint-tsgolint": {
			"optional": true
		},
		"tsrs": {
			"optional": true
		},
		"@stylistic/eslint-plugin": {
			"optional": true
		}
	}
}
