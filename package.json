{
	"name": "@misskey-dev/oxlint-fmt-config",
	"version": "0.0.3",
	"description": "oxlint/oxfmt config for misskey-dev",
	"license": "MIT",
	"packageManager": "pnpm@11.18.0",
	"files": [
		"built"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./built/index.mjs",
			"types": "./built/index.d.mts"
		},
		"./oxlint": {
			"import": "./built/oxlint/index.mjs",
			"types": "./built/oxlint/index.d.mts"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/misskey-dev/oxlint-fmt-config-misskey-dev"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm build && oxlint"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "5.10.0",
		"corsa-oxlint": "1.4.0",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "7.0.2001",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@stylistic/eslint-plugin": "5.10.0",
		"corsa-oxlint": "^1",
		"oxlint": "^1",
		"oxlint-tsgolint": "0.23.0"
	},
	"peerDependenciesMeta": {
		"@stylistic/eslint-plugin": {
			"optional": true
		},
		"corsa-oxlint": {
			"optional": true
		}
	}
}
